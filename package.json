{
  "name": "shahane-gpt",
  "version": "1.0.0",
  "description": "Shahane GPT: C++ Q&A engine + Express backend + Google Gemini AI, served at http://localhost:3000",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:cpp": "node scripts/build-cpp.js",
    "setup": "npm install && npm run build:cpp",
    "prestart": "node scripts/ensure-cpp.js",
    "start": "node server/index.js",
    "test": "node scripts/ensure-cpp.js && node scripts/smoke-test.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "express": "^4.22.3"
  }
}
